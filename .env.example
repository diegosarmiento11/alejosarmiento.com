# Todo es opcional: sin estas variables el sitio corre con datos en memoria.

# Upstash Redis (Vercel Marketplace). Contadores, reacciones y comentarios.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Brevo. Newsletter y avisos de comentarios. BREVO_LIST_ID es el número de la lista.
BREVO_API_KEY=
BREVO_LIST_ID=
EMAIL_FROM="Alejandro Sarmiento <hola@alejosarmiento.com>"
# Recibe los avisos de comentarios y las respuestas a los correos.
OWNER_EMAIL=

# Firma los enlaces de confirmación y moderación. Generar con: openssl rand -hex 32
SIGNING_SECRET=

# Pantalla /escribir. Sin ADMIN_PASSWORD la pantalla queda cerrada en producción.
ADMIN_PASSWORD=
# Token "fine-grained" de GitHub con permiso Contents (lectura y escritura) solo sobre este repo.
# Sin él, en desarrollo el post se escribe en content/blog/ y en producción no se publica.
GITHUB_TOKEN=
GITHUB_REPO=diegosarmiento11/alejosarmiento.com
GITHUB_BRANCH=main
